(async function () {
    if (!window.Game) return alert("Open Cookie Clicker first!");

    Game.Notify("Cookie God Loaded", "Smooth UI Edition • SyncX", [16,5]);

    // ================= UI =================
    const ui = document.createElement("div");
    ui.style = `
        position:fixed;
        top:${localStorage.cg_top || "100px"};
        left:${localStorage.cg_left || "100px"};
        width:420px;height:520px;
        background:rgba(15,15,20,0.9);
        backdrop-filter:blur(12px);
        border-radius:14px;
        box-shadow:0 0 25px rgba(0,255,255,0.15);
        display:flex;flex-direction:column;
        z-index:999999;color:white;
        font-family:sans-serif;
        resize:both;
        overflow:hidden;
    `;

    // HEADER
    const header = document.createElement("div");
    header.innerHTML = `
        🍪 Cookie God
        <span style="float:right;cursor:pointer;" id="minBtn">—</span>
    `;
    header.style = `
        padding:10px;
        background:#111;
        cursor:move;
        user-select:none;
    `;

    // CONTENT
    const content = document.createElement("div");
    content.style = `flex:1;overflow:auto;padding:10px;`;

    // QUICK BAR
    const quick = document.createElement("div");
    quick.style = `display:flex;gap:5px;margin-bottom:8px;`;

    function qbtn(name, fn){
        let b=document.createElement("button");
        b.innerText=name;
        b.style="flex:1;padding:6px;background:#222;border:none;color:#0ff;border-radius:6px;";
        b.onclick=fn;
        quick.appendChild(b);
    }

    qbtn("Max $",()=>Game.cookies=1e300);
    qbtn("x100 CPS",()=>Game.cookiesPs*=100);
    qbtn("Golden",()=>Game.shimmers.forEach(s=>s.pop()));

    content.appendChild(quick);

    function btn(name, fn){
        let b=document.createElement("button");
        b.innerText=name;
        b.style=`
            width:100%;margin:4px 0;padding:8px;
            background:#1a1f27;border:none;
            border-radius:8px;color:#0ff;
            cursor:pointer;
        `;
        b.onclick=fn;
        content.appendChild(b);
    }

    function toggle(name, fn){
        let on=false;
        let b=document.createElement("button");
        b.innerText=name+" OFF";
        b.style=`
            width:100%;margin:4px 0;padding:8px;
            background:#1a1f27;border:none;
            border-radius:8px;color:#0ff;
        `;
        b.onclick=()=>{
            on=!on;
            b.innerText=name+(on?" ON":" OFF");
            fn(on);
        };
        content.appendChild(b);
    }

    // FEATURES
    btn("Set Cookies",()=>{
        let v=prompt("Amount:");
        if(v) Game.cookies=parseFloat(v);
    });

    btn("Unlock Everything",()=>{
        Game.UpgradesById.forEach(u=>u.unlock());
        Game.AchievementsById.forEach(a=>a.won=1);
    });

    btn("Max Buildings",()=>Game.ObjectsById.forEach(o=>o.amount=9999));

    toggle("Auto Click",(on)=>{
        if(on) window.ac=setInterval(()=>Game.ClickCookie(),1);
        else clearInterval(window.ac);
    });

    toggle("Auto Buy",(on)=>{
        if(on) window.ab=setInterval(()=>{
            Game.ObjectsById.forEach(o=>{
                if(o.getPrice()<Game.cookies) o.buy(1);
            });
        },800);
        else clearInterval(window.ab);
    });

    toggle("Auto Golden",(on)=>{
        if(on) window.ag=setInterval(()=>{
            Game.shimmers.forEach(s=>s.pop());
        },500);
        else clearInterval(window.ag);
    });

    btn("Golden Storm",()=>{
        for(let i=0;i<40;i++) Game.shimmer("golden");
    });

    btn("Open Dev Panel",()=>Game.OpenSesame());

    btn("Close UI",()=>ui.remove());

    // MINIMIZE
    let minimized=false;
    header.querySelector("#minBtn").onclick=()=>{
        minimized=!minimized;
        content.style.display=minimized?"none":"block";
    };

    // DRAGGING (SMOOTH)
    let offsetX=0, offsetY=0, dragging=false;

    header.addEventListener("mousedown", e=>{
        dragging=true;
        offsetX=e.clientX-ui.offsetLeft;
        offsetY=e.clientY-ui.offsetTop;
    });

    document.addEventListener("mousemove", e=>{
        if(!dragging) return;

        let x=e.clientX-offsetX;
        let y=e.clientY-offsetY;

        // SNAP TO EDGE
        if(x<20) x=0;
        if(y<20) y=0;

        ui.style.left=x+"px";
        ui.style.top=y+"px";
    });

    document.addEventListener("mouseup", ()=>{
        dragging=false;

        // SAVE POSITION
        localStorage.cg_top=ui.style.top;
        localStorage.cg_left=ui.style.left;
    });

    // ADD
    ui.appendChild(header);
    ui.appendChild(content);
    document.body.appendChild(ui);

})();
